function assertEqual(
  testName,
  actual,
  expected,
  fieldPath
) {
  insomnia.test(testName, () => {
    insomnia.expect(
      actual,
      `${fieldPath} no coincide. ` +
      `LEGADO=${JSON.stringify(expected)} | ` +
      `MIGRADO=${JSON.stringify(actual)}`
    ).to.deep.eql(expected);
  });
}

function assertNotEmpty(
  testName,
  value,
  fieldPath
) {
  insomnia.test(testName, () => {
    insomnia.expect(
      value,
      `${fieldPath} está vacío o no fue retornado`
    ).to.be.a('string').and.not.empty;
  });
}

