// ======================================================
// FUNCIONES PARA ENVÍO HTTP
// ======================================================

function sendSoapRequest(url, xmlBody) {
  const request = {
    url,
    method: 'POST',
    header: HEADERS,
    body: {
      mode: 'raw',
      raw: xmlBody
    }
  };

  const startedAt = Date.now();

  return new Promise((resolve, reject) => {
    insomnia.sendRequest(request, (error, response) => {
      const elapsedMs = Date.now() - startedAt;

      if (error) {
        reject(
          new Error(
            `No fue posible consumir ${url}: ${error.message || error}`
          )
        );
        return;
      }

      resolve({
        response,
        elapsedMs
      });
    });
  });
}

async function getResponseText(response) {
  if (response && typeof response.text === 'function') {
    return await Promise.resolve(response.text());
  }

  if (response && typeof response.body === 'string') {
    return response.body;
  }

  if (
    response &&
    response.body &&
    typeof response.body.toString === 'function'
  ) {
    return response.body.toString('utf8');
  }

  return '';
}

function getHttpCode(response) {
  if (typeof response.code === 'number') {
    return response.code;
  }

  if (typeof response.statusCode === 'number') {
    return response.statusCode;
  }

  const converted = Number(response.status);

  return Number.isNaN(converted)
    ? undefined
    : converted;
}

// ======================================================
// FUNCIONES PARA PROCESAR XML
// ======================================================

const XML_OPTIONS = {
  explicitArray: false,
  explicitRoot: true,
  trim: true,
  mergeAttrs: false,
  emptyTag: ''
};

function removeNamespace(name) {
  return name.includes(':')
    ? name.split(':').pop()
    : name;
}

function cleanNamespaces(value) {
  if (Array.isArray(value)) {
    return value.map(cleanNamespaces);
  }

  if (value !== null && typeof value === 'object') {
    const result = {};

    for (const [key, childValue] of Object.entries(value)) {
      result[removeNamespace(key)] =
        cleanNamespaces(childValue);
    }

    return result;
  }

  return value;
}

function findNode(value, searchedName) {
  if (value === null || value === undefined) {
    return undefined;
  }

  if (Array.isArray(value)) {
    for (const item of value) {
      const found = findNode(item, searchedName);

      if (found !== undefined) {
        return found;
      }
    }

    return undefined;
  }

  if (typeof value === 'object') {
    for (const [key, childValue] of Object.entries(value)) {
      if (removeNamespace(key) === searchedName) {
        return childValue;
      }

      const found = findNode(childValue, searchedName);

      if (found !== undefined) {
        return found;
      }
    }
  }

  return undefined;
}

function scalar(value) {
  if (value === undefined || value === null) {
    return '';
  }

  if (
    typeof value === 'object' &&
    Object.prototype.hasOwnProperty.call(value, '_')
  ) {
    return String(value._).trim();
  }

  if (typeof value === 'object') {
    return '';
  }

  return String(value).trim();
}

function toArray(value) {
  if (
    value === undefined ||
    value === null ||
    value === ''
  ) {
    return [];
  }

  return Array.isArray(value)
    ? value
    : [value];
}

async function parseXml(xml, environmentName) {
  if (!xml || !xml.trim()) {
    throw new Error(
      `El servicio ${environmentName} devolvió un body vacío.`
    );
  }

  try {
    const parsed = await xml2js.parseStringPromise(
      xml,
      XML_OPTIONS
    );

    return cleanNamespaces(parsed);
  } catch (error) {
    throw new Error(
      `El response de ${environmentName} no es XML válido: ` +
      `${error.message}`
    );
  }
}

// ======================================================
// EXTRACCIÓN DE COTITULARES
// ======================================================

function normalizePerson(person) {
  return {
    cif: scalar(person && person.cif),
    nombre: scalar(person && person.nombre),
    identificacion: scalar(
      person && person.identificacion
    ),
    tipoIdentificacion: scalar(
      person && person.tipoIdentificacion
    )
  };
}

function extractCotitulares(bodyOut) {
  if (!bodyOut || typeof bodyOut !== 'object') {
    return [];
  }

  let candidates = [];

  /*
   * Estructuras soportadas:
   *
   * <cotitulares>
   *   <cotitular>...</cotitular>
   * </cotitulares>
   *
   * <cotitular>...</cotitular>
   *
   * <cotitular1>...</cotitular1>
   * ...
   * <cotitular14>...</cotitular14>
   */

  if (bodyOut.cotitulares) {
    const container = bodyOut.cotitulares;

    if (
      container &&
      typeof container === 'object' &&
      container.cotitular !== undefined
    ) {
      candidates = candidates.concat(
        toArray(container.cotitular)
      );
    } else {
      candidates = candidates.concat(
        toArray(container)
      );
    }
  }

  if (bodyOut.cotitular !== undefined) {
    candidates = candidates.concat(
      toArray(bodyOut.cotitular)
    );
  }

  for (const [key, value] of Object.entries(bodyOut)) {
    if (/^cotitular(?:[1-9]|1[0-4])$/i.test(key)) {
      candidates = candidates.concat(toArray(value));
    }
  }

  return candidates
    .filter(item => item && typeof item === 'object')
    .map(normalizePerson)
    .filter(person => {
      return (
        person.cif !== '' ||
        person.nombre !== '' ||
        person.identificacion !== '' ||
        person.tipoIdentificacion !== ''
      );
    });
}

// ======================================================
// CREACIÓN DEL SNAPSHOT FUNCIONAL
// ======================================================

function buildSnapshot(normalizedXml) {
  const responseNode =
    findNode(
      normalizedXml,
      'ConsultarCotitularesCuenta01Response'
    ) ||
    findNode(
      normalizedXml,
      'ModificarTitularidadCuenta22Response'
    );

  const bodyOut = findNode(normalizedXml, 'bodyOut');
  const errorBlock = findNode(normalizedXml, 'error');

  const titular =
    bodyOut &&
    typeof bodyOut === 'object'
      ? bodyOut.titular
      : undefined;

  return {
    operation: responseNode
      ? Object.keys(normalizedXml).join(',')
      : '',

    responsePresent: Boolean(responseNode),

    error: {
      codigo: scalar(errorBlock && errorBlock.codigo),
      mensaje: scalar(errorBlock && errorBlock.mensaje),
      mensajeNegocio: scalar(
        errorBlock && errorBlock.mensajeNegocio
      ),
      tipo: scalar(errorBlock && errorBlock.tipo),
      recurso: scalar(errorBlock && errorBlock.recurso),
      componente: scalar(
        errorBlock && errorBlock.componente
      ),
      backend: scalar(errorBlock && errorBlock.backend)
    },

    bodyOut: {
      condicion: scalar(bodyOut && bodyOut.condicion),
      cuentaCredito: scalar(
        bodyOut && bodyOut.cuentaCredito
      ),
      observaciones: scalar(
        bodyOut && bodyOut.observaciones
      ),

      titular: normalizePerson(titular),

      cotitulares: extractCotitulares(bodyOut)
    }
  };
}

