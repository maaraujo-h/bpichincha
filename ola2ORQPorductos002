const legacyUrl =
'http://10.60.128.86:6000/IntegrationBus/soap/ORQProductos0002';

const body =
await insomnia.environment.get('soapBody');

await new Promise((resolve,reject)=>{

    insomnia.sendRequest({

        url: legacyUrl,

        method: 'POST',

        headers:{
            'Content-Type':'text/xml;charset=UTF-8'
        },

        body:{
            mimeType:'application/xml',
            text: body
        }

    },(err,response)=>{

        if(err){

            console.error(err);
            reject(err);
            return;

        }

        console.log(response.status);

        resolve();

    });

});
