function normalizeBusinessMessage(message) {
  if (!message) {
    return '';
  }

  return String(message)
    .replace(/^TCSBRKR\d*_BP[:\-]/i, '')
    .replace(/^WSClientes0119[:\-]/i, '')
    .replace(/^ConsultarSegmentoSubsegmento01[:\-]/i, '')
    .replace(/^\d+[:\-]/, '')
    .trim();
}

