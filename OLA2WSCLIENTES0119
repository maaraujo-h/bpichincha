// ======================================================
// 3. ENVÍO DE REQUEST SOAP
// ======================================================

function sendSoapRequest(environmentName, url, xmlBody) {
  const requestConfig = {
    url,
    method: 'POST',

    header: {
      'Content-Type': CONFIG.headers['Content-Type'],
      Accept: CONFIG.headers.Accept
    },

    body: {
      mode: 'raw',
      raw: xmlBody
    }
  };

  const startTime = Date.now();

  return new Promise((resolve, reject) => {
    insomnia.sendRequest(
      requestConfig,
      async (error, response) => {
        const elapsedMs = Date.now() - startTime;

        if (error) {
          reject(
            new Error(
              `${environmentName}: no fue posible ejecutar el request. ` +
              `${error.message || error}`
            )
          );
          return;
        }

        try {
          const responseText =
            await getResponseText(response);

          resolve({
            environmentName,
            response,
            responseText,
            elapsedMs,
            httpCode: getHttpCode(response)
          });
        } catch (readError) {
          reject(
            new Error(
              `${environmentName}: no fue posible leer la respuesta. ` +
              `${readError.message}`
            )
          );
        }
      }
    );
  });
}

async function getResponseText(response) {
  if (
    response &&
    typeof response.text === 'function'
  ) {
    return await Promise.resolve(response.text());
  }

  if (
    response &&
    typeof response.body === 'string'
  ) {
    return response.body;
  }

  if (
    response &&
    response.body &&
    typeof response.body.toString === 'function'
  ) {
    return response.body.toString('utf8');
  }

  return '';
}

function getHttpCode(response) {
  if (
    response &&
    typeof response.code === 'number'
  ) {
    return response.code;
  }

  if (
    response &&
    typeof response.statusCode === 'number'
  ) {
    return response.statusCode;
  }

  const converted = Number(
    response ? response.status : undefined
  );

  return Number.isNaN(converted)
    ? undefined
    : converted;
}

// ======================================================
// 4. PARSING Y NORMALIZACIÓN DEL XML
// ======================================================

const XML_OPTIONS = {
  explicitArray: false,
  explicitRoot: true,
  trim: true,
  mergeAttrs: false,
  emptyTag: ''
};

function removeNamespace(name) {
  if (typeof name !== 'string') {
    return name;
  }

  return name.includes(':')
    ? name.split(':').pop()
    : name;
}

function cleanNamespaces(value) {
  if (Array.isArray(value)) {
    return value.map(cleanNamespaces);
  }

  if (
    value !== null &&
    typeof value === 'object'
  ) {
    const cleanObject = {};

    for (
      const [key, childValue]
      of Object.entries(value)
    ) {
      cleanObject[removeNamespace(key)] =
        cleanNamespaces(childValue);
    }

    return cleanObject;
  }

  return value;
}

function findNode(value, searchedName) {
  if (
    value === null ||
    value === undefined
  ) {
    return undefined;
  }

  if (Array.isArray(value)) {
    for (const item of value) {
      const found = findNode(
        item,
        searchedName
      );

      if (found !== undefined) {
        return found;
      }
    }

    return undefined;
  }

  if (typeof value === 'object') {
    for (
      const [key, childValue]
      of Object.entries(value)
    ) {
      if (
        removeNamespace(key) === searchedName
      ) {
        return childValue;
      }

      const found = findNode(
        childValue,
        searchedName
      );

      if (found !== undefined) {
        return found;
      }
    }
  }

  return undefined;
}

function scalar(value) {
  if (
    value === undefined ||
    value === null
  ) {
    return '';
  }

  if (
    typeof value === 'object' &&
    Object.prototype.hasOwnProperty.call(
      value,
      '_'
    )
  ) {
    return String(value._).trim();
  }

  if (typeof value === 'object') {
    return '';
  }

  return String(value).trim();
}

async function parseXml(xml, sourceName) {
  if (!xml || !xml.trim()) {
    throw new Error(
      `${sourceName}: el body de la respuesta está vacío.`
    );
  }

  try {
    const parsed =
      await xml2js.parseStringPromise(
        xml,
        XML_OPTIONS
      );

    return cleanNamespaces(parsed);
  } catch (error) {
    throw new Error(
      `${sourceName}: la respuesta no contiene XML válido. ` +
      `${error.message}`
    );
  }
}

// ======================================================
// 5. CONSTRUIR SNAPSHOT FUNCIONAL
// ======================================================

function buildResponseSnapshot(
  normalizedXml,
  sourceName
) {
  const responseNode = findNode(
    normalizedXml,
    'ConsultarSegmentoSubsegmento01Response'
  );

  const bodyOut = findNode(
    normalizedXml,
    'bodyOut'
  );

  const errorBlock = findNode(
    normalizedXml,
    'error'
  );

  return {
    sourceName,

    responseNodePresent:
      Boolean(responseNode),

    bodyOut: {
      nombreCompleto: scalar(
        bodyOut?.nombreCompleto
      ),

      segmento: scalar(
        bodyOut?.segmento
      ),

      subsegmento: scalar(
        bodyOut?.subsegmento
      )
    },

    error: {
      codigo: scalar(
        errorBlock?.codigo
      ),

      mensaje: scalar(
        errorBlock?.mensaje
      ),

      mensajeNegocio: scalar(
        errorBlock?.mensajeNegocio
      ),

      tipo: scalar(
        errorBlock?.tipo
      ),

      recurso: scalar(
        errorBlock?.recurso
      ),

      componente: scalar(
        errorBlock?.componente
      ),

      backend: scalar(
        errorBlock?.backend
      )
    }
  };
}

// ======================================================
// 6. EXTRAER DATOS DEL REQUEST
// ======================================================

function buildRequestSnapshot(
  normalizedRequest
) {
  const operation = findNode(
    normalizedRequest,
    'ConsultarSegmentoSubsegmento01'
  );

  const bodyIn = operation?.bodyIn ??
    findNode(
      normalizedRequest,
      'bodyIn'
    );

  return {
    operationPresent:
      Boolean(operation),

    numeroCuenta: scalar(
      bodyIn?.numeroCuenta
    ),

    identificacion: scalar(
      bodyIn?.identificacion
    ),

    tipoIdentificacion: scalar(
      bodyIn?.tipoIdentificacion
    )
  };
}

