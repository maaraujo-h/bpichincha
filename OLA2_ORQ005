      cleanObject[removeNamespacePrefix(key)] =
        removeNamespaces(childValue);
    }

    return cleanObject;
  }

  return value;
}

function findFirstByKey(value, searchedKey) {
  if (value === null || value === undefined) {
    return undefined;
  }

  if (Array.isArray(value)) {
    for (const element of value) {
      const result = findFirstByKey(element, searchedKey);

      if (result !== undefined) {
        return result;
      }
    }

    return undefined;
  }

  if (typeof value === 'object') {
    for (const [key, childValue] of Object.entries(value)) {
      if (removeNamespacePrefix(key) === searchedKey) {
        return childValue;
      }

      const result = findFirstByKey(childValue, searchedKey);

      if (result !== undefined) {
        return result;
      }
    }
  }

  return undefined;
}

function scalarValue(value) {
  if (value === undefined || value === null) {
    return '';
  }

  if (typeof value === 'object' && '_' in value) {
    return String(value._).trim();
  }

  if (typeof value === 'object') {
    return '';
  }

  return String(value).trim();
}

function normalizeBusinessMessage(message) {
  if (!message) {
    return '';
  }

  return String(message)
    .replace(/^TCSBRKR2_BP[:\-]/i, '')
    .replace(/^ORQProductos0035:7012-/i, '')
    .trim();
}

function normalizeEmptyValues(value) {
  if (Array.isArray(value)) {
    return value.map(normalizeEmptyValues);
  }

  if (value !== null && typeof value === 'object') {
    const result = {};

    for (const [key, childValue] of Object.entries(value)) {
      result[key] = normalizeEmptyValues(childValue);
    }

    return result;
  }

  if (value === undefined || value === null) {
    return '';
  }

  return value;
}

function removeDynamicFields(value) {
  const copy = lodash.cloneDeep(value);

  const dynamicFields = new Set([
    'fechaHora',
    'guid',
    'sesion',
    'unicidad',
    'responseTime',
    'timestamp',
    'correlationId',
    'traceId'
  ]);

  function walk(currentValue) {
    if (Array.isArray(currentValue)) {
      currentValue.forEach(walk);
      return;
    }

    if (
      currentValue === null ||
      typeof currentValue !== 'object'
    ) {
      return;
    }

    for (const key of Object.keys(currentValue)) {
      if (dynamicFields.has(removeNamespacePrefix(key))) {
        delete currentValue[key];
      } else {
        walk(currentValue[key]);
      }
    }
  }

  walk(copy);
  return copy;
}

function createContactKey(contact) {
  return [
    scalarValue(contact.codigo),
    scalarValue(contact.numeroProducto),
    scalarValue(contact.nombre)
  ].join('|');
}

function sortContacts(contacts) {
  return [...contacts].sort((left, right) =>
    createContactKey(left).localeCompare(
      createContactKey(right)
    )
  );
}

