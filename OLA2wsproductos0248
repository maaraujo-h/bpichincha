      `${fieldPath} incumple la regla. ` +
      `Esperado=${JSON.stringify(expected)} | ` +
      `Obtenido=${JSON.stringify(actual)}`
    ).to.eql(expected);
  });
}

function assertNotEmpty(
  testName,
  value,
  fieldPath
) {
  insomnia.test(testName, () => {
    insomnia.expect(
      value,
      `${fieldPath} está vacío o no fue retornado`
    ).to.be.a('string').and.not.empty;
  });
}

function normalizeBusinessMessage(message) {
  if (!message) {
    return '';
  }

  return String(message)
    .replace(/^TCSBRKR\d*_BP[:\-]/i, '')
    .replace(/^WSProductos0248[:\-]/i, '')
    .replace(/^ConsultarIntervinientesClientes02[:\-]/i, '')
    .replace(/^\d+[:\-]/, '')
    .trim();
}

