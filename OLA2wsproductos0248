// ======================================================
// 2. OBTENER EL XML ACTUAL DEL BODY
// ======================================================

function getCurrentRequestBody() {
  const body = insomnia.request.body;

  if (!body) {
    return '';
  }

  if (typeof body === 'string') {
    return body;
  }

  if (typeof body.raw === 'string') {
    return body.raw;
  }

  if (typeof body.text === 'string') {
    return body.text;
  }

  return '';
}

const REQUEST_XML = getCurrentRequestBody();

if (!REQUEST_XML || !REQUEST_XML.trim()) {
  throw new Error(
    'No se encontró el XML del request. ' +
    'Configura el Body de Insomnia en modo XML/raw.'
  );
}

// ======================================================
// 3. ENVÍO SOAP
// ======================================================

function sendSoapRequest(environmentName, url, xmlBody) {
  const requestConfig = {
    url,
    method: 'POST',

    header: {
      'Content-Type': CONFIG.headers['Content-Type'],
      Accept: CONFIG.headers.Accept
    },

    body: {
      mode: 'raw',
      raw: xmlBody
    }
  };

  const startedAt = Date.now();

  return new Promise((resolve, reject) => {
    insomnia.sendRequest(
      requestConfig,
      async (error, response) => {
        const elapsedMs = Date.now() - startedAt;

        if (error) {
          reject(
            new Error(
              `${environmentName}: error al ejecutar el request. ` +
              `${error.message || error}`
            )
          );
          return;
        }

        try {
          const responseText = await getResponseText(
            response
          );

          resolve({
            environmentName,
            response,
            responseText,
            elapsedMs,
            httpCode: getHttpCode(response)
          });
        } catch (readError) {
          reject(
            new Error(
              `${environmentName}: no fue posible leer el response. ` +
              `${readError.message}`
            )
          );
        }
      }
    );
  });
}

async function getResponseText(response) {
  if (
    response &&
    typeof response.text === 'function'
  ) {
    return await Promise.resolve(response.text());
  }

  if (
    response &&
    typeof response.body === 'string'
  ) {
    return response.body;
  }

  if (
    response &&
    response.body &&
    typeof response.body.toString === 'function'
  ) {
    return response.body.toString('utf8');
  }

  return '';
}

function getHttpCode(response) {
  if (
    response &&
    typeof response.code === 'number'
  ) {
    return response.code;
  }

  if (
    response &&
    typeof response.statusCode === 'number'
  ) {
    return response.statusCode;
  }

  const parsed = Number(
    response ? response.status : undefined
  );

  return Number.isNaN(parsed)
    ? undefined
    : parsed;
}

// ======================================================
// 4. PARSING Y NORMALIZACIÓN XML
// ======================================================

const XML_OPTIONS = {
  explicitArray: false,
  explicitRoot: true,
  trim: true,
  mergeAttrs: false,
  emptyTag: ''
};

function removeNamespace(name) {
  if (typeof name !== 'string') {
    return name;
  }

  return name.includes(':')
    ? name.split(':').pop()
    : name;
}

function cleanNamespaces(value) {
  if (Array.isArray(value)) {
    return value.map(cleanNamespaces);
  }

  if (
    value !== null &&
    typeof value === 'object'
  ) {
    const result = {};

    for (
      const [key, childValue]
      of Object.entries(value)
    ) {
      result[removeNamespace(key)] =
        cleanNamespaces(childValue);
    }

    return result;
  }

  return value;
}

function findNode(value, searchedName) {
  if (
    value === null ||
    value === undefined
  ) {
    return undefined;
  }

  if (Array.isArray(value)) {
    for (const item of value) {
      const found = findNode(
        item,
        searchedName
      );

      if (found !== undefined) {
        return found;
      }
    }

    return undefined;
  }

  if (typeof value === 'object') {
    for (
      const [key, childValue]
      of Object.entries(value)
    ) {
      if (
        removeNamespace(key) === searchedName
      ) {
        return childValue;
      }

      const found = findNode(
        childValue,
        searchedName
      );

      if (found !== undefined) {
        return found;
      }
    }
  }

  return undefined;
}

function scalar(value) {
  if (
    value === undefined ||
    value === null
  ) {
    return '';
  }

  if (
    typeof value === 'object' &&
    Object.prototype.hasOwnProperty.call(
      value,
      '_'
    )
  ) {
    return String(value._).trim();
  }

  if (typeof value === 'object') {
    return '';
  }

  return String(value).trim();
}

function toArray(value) {
  if (
    value === undefined ||
    value === null ||
    value === ''
  ) {
    return [];
  }

  return Array.isArray(value)
    ? value
    : [value];
}

async function parseXml(xml, sourceName) {
  if (!xml || !xml.trim()) {
    throw new Error(
      `${sourceName}: el response está vacío.`
    );
  }

  try {
    const parsed =
      await xml2js.parseStringPromise(
        xml,
        XML_OPTIONS
      );

    return cleanNamespaces(parsed);
  } catch (error) {
    throw new Error(
      `${sourceName}: XML inválido. ${error.message}`
    );
  }
}

// ======================================================
// 5. NORMALIZACIÓN DE GRUPOS E INTERVINIENTES
// ======================================================

function normalizeCifList(group) {
  if (
    group === undefined ||
    group === null ||
    group === ''
  ) {
    return [];
  }

  const rawCifs =
    typeof group === 'object' &&
    group.cif !== undefined
      ? group.cif
      : group;

  return toArray(rawCifs)
    .map(scalar)
    .filter(value => value !== '');
}

function normalizeInterviniente(item) {
  return {
    cif: scalar(item?.cif),
    nombre: scalar(item?.nombre),
    identificacion: scalar(
      item?.identificacion
    ),
    tipoIdentificacion: scalar(
      item?.tipoIdentificacion
    )
  };
}

function normalizeIntervinientes(value) {
  return toArray(value)
    .filter(
      item =>
        item &&
        typeof item === 'object'
    )
    .map(normalizeInterviniente);
}

// ======================================================
// 6. CONSTRUIR SNAPSHOT DE RESPUESTA
// ======================================================

function buildResponseSnapshot(
  normalizedXml,
  sourceName
) {
  const responseNode = findNode(
    normalizedXml,
    'ConsultarIntervinientesClientes02Response'
  );

  const bodyOut = findNode(
    normalizedXml,
    'bodyOut'
  );

  const errorBlock = findNode(
    normalizedXml,
    'error'
  );

  const condicionesIntervinientes =
    bodyOut?.condicionesIntervinientes;

  const intervinientesBlock =
    condicionesIntervinientes?.intervinientes;

  const agrupaciones =
    intervinientesBlock?.agrupaciones;

  const intervinientes =
    normalizeIntervinientes(
      intervinientesBlock?.interviniente
    );

  return {
    sourceName,

    responseNodePresent:
      Boolean(responseNode),

    error: {
      codigo: scalar(
        errorBlock?.codigo
      ),

      mensaje: scalar(
        errorBlock?.mensaje
      ),

      mensajeNegocio: scalar(
        errorBlock?.mensajeNegocio
      ),

      tipo: scalar(
        errorBlock?.tipo
      ),

      recurso: scalar(
        errorBlock?.recurso
      ),

      componente: scalar(
        errorBlock?.componente
      ),

      backend: scalar(
        errorBlock?.backend
      )
    },

    bodyOut: {
      numeroConfiguracion: scalar(
        intervinientesBlock?.numeroConfiguracion
      ),

      grupos: {
        grupo1: normalizeCifList(
          agrupaciones?.grupo1
        ),

        grupo2: normalizeCifList(
          agrupaciones?.grupo2
        ),

        grupo3: normalizeCifList(
          agrupaciones?.grupo3
        ),

        grupo4: normalizeCifList(
          agrupaciones?.grupo4
        ),

        grupo5: normalizeCifList(
          agrupaciones?.grupo5
        )
      },

      intervinientes
    }
  };
}

// ======================================================
// 7. EXTRAER DATOS DEL REQUEST
// ======================================================

function buildRequestSnapshot(
  normalizedRequest
) {
  const operation = findNode(
    normalizedRequest,
    'ConsultarIntervinientesClientes02'
  );

  const bodyIn =
    operation?.bodyIn ??
    findNode(
      normalizedRequest,
      'bodyIn'
    );

  const condicion =
    bodyIn?.condicion;

  return {
    operationPresent:
      Boolean(operation),

    cuenta: scalar(
      bodyIn?.cuenta
    ),

    numeroCondicion: scalar(
      condicion?.numeroCondicion
    ),

    funcion: scalar(
      condicion?.funcion
    ),

    usuarioCif: scalar(
      condicion?.usuarioCif
    ),

    numeroTransaccion: scalar(
      condicion?.numeroTransaccion
    )
  };
}

