4. Script automático para Insomnia

Insomnia permite colocar pruebas en Scripts → After-response, ejecutarlas al recibir la respuesta y mostrarlas en el indicador Tests. También permite posteriormente ejecutar varias solicitudes mediante Collection Runner. Documentación oficial de scripts, documentación de Collection Runner.

Pega este script en Scripts → After-response de cada request:

const config = {
  caseId: 'EP-001',
  expectedCode: '0',
  messageContains: 'OK',
  expectChannelList: true,
  expectedCuentaActiva: null,
  requireNonEmptyMessage: false
};

const body = insomnia.response.text();

function getTagValue(tagName) {
  const expression = new RegExp(
    `<(?:(?:[\\w.-]+):)?${tagName}(?:\\s[^>]*)?>\\s*([^<]*)\\s*<\\/(?:(?:[\\w.-]+):)?${tagName}\\s*>`,
    'i'
  );

  const result = body.match(expression);
  return result ? result[1].trim() : null;
}

const codigo = getTagValue('codigo');
const mensaje = getTagValue('mensaje');

insomnia.test(`${config.caseId} - HTTP 200`, () => {
  insomnia.expect(insomnia.response.status).to.eql(200);
});

insomnia.test(`${config.caseId} - Respuesta SOAP`, () => {
  insomnia.expect(body).to.match(/Envelope/i);
});

insomnia.test(`${config.caseId} - Sin SOAP Fault`, () => {
  insomnia.expect(body).not.to.match(
    /<(?:[\w.-]+:)?Fault(?:\s|>)/i
  );
});

insomnia.test(
  `${config.caseId} - Código ${config.expectedCode}`,
  () => {
    insomnia.expect(codigo).to.eql(config.expectedCode);
  }
);

if (config.messageContains) {
  insomnia.test(
    `${config.caseId} - Mensaje esperado`,
    () => {
      insomnia.expect(mensaje || '').to.include(
        config.messageContains
      );
    }
  );
}

if (config.requireNonEmptyMessage) {
  insomnia.test(
    `${config.caseId} - Mensaje backend informado`,
    () => {
      insomnia.expect(mensaje).to.be.a('string');
      insomnia.expect(mensaje.length).to.be.greaterThan(0);
    }
  );
}

if (config.expectChannelList) {
  insomnia.test(
    `${config.caseId} - Lista de canales informada`,
    () => {
      insomnia.expect(body).to.match(
        /<(?:[\w.-]+:)?(?:canales|canal)(?:\s|>)/i
      );
    }
  );
}

if (config.expectedCuentaActiva !== null) {
  insomnia.test(
    `${config.caseId} - cuentaActiva=${config.expectedCuentaActiva}`,
    () => {
      const elementPattern =
        /<(?:[\w.-]+:)?cuentaActiva(?:\s[^>]*)?>\s*false\s*<\/(?:[\w.-]+:)?cuentaActiva>/i;

      const attributePattern =
        /\bcuentaActiva\s*=\s*["']false["']/i;

      insomnia.expect(
        elementPattern.test(body) ||
        attributePattern.test(body)
      ).to.eql(true);
    }
  );
}
